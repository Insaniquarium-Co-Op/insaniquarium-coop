+// Co-op test harness: dump the current back buffer (call after drawing, before the swap).
+namespace Sexy
+{
+	// The screen as RGBA rows, bottom row first (test videos; see coop/CoopTest.cpp).
+	bool ReadBackbuffer(std::vector<uint32_t>& theOut, int& theW, int& theH)
+	{
+		SDL_GL_GetDrawableSize((SDL_Window*)gSexyAppBase->mWindow, &theW, &theH);
+		if (theW <= 0 || theH <= 0)
+			return false;
+		theOut.resize((size_t)theW * theH);
+		glReadPixels(0, 0, theW, theH, GL_RGBA, GL_UNSIGNED_BYTE, theOut.data());
+		return true;
+	}
+
+	bool WriteBackbufferPNG(const std::string& thePath)
+	{
+		int w = 0, h = 0;
+		SDL_GL_GetDrawableSize((SDL_Window*)gSexyAppBase->mWindow, &w, &h);
+		if (w <= 0 || h <= 0)
+			return false;
+		std::vector<uint32_t> aBuf(w * h);
+		glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, aBuf.data());
+		ImageLib::Image anImage;
+		anImage.mWidth = w;
+		anImage.mHeight = h;
+		anImage.mBits = new uint32_t[w * h];
+		for (int y = 0; y < h; y++)
+		{
+			const uint32_t* src = aBuf.data() + (h - 1 - y) * w;
+			uint32_t* dst = anImage.mBits + y * w;
+			for (int x = 0; x < w; x++)
+				dst[x] = RgbaToArgb(src[x]) | 0xFF000000u;
+		}
+		return ImageLib::WritePNGImage(thePath, &anImage);
+	}
+}
+
