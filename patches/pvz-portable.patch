+
+void WidgetManager::SwapMouseState(MouseState& theState)
+{
+	std::swap(mMouseIn, theState.mMouseIn);
+	std::swap(mLastMouseX, theState.mLastMouseX);
+	std::swap(mLastMouseY, theState.mLastMouseY);
+	std::swap(mDownButtons, theState.mDownButtons);
+	std::swap(mActualDownButtons, theState.mActualDownButtons);
+	std::swap(mLastDownButtonId, theState.mLastDownButtonId);
+	std::swap(mLastDownWidget, theState.mLastDownWidget);
+	std::swap(mOverWidget, theState.mOverWidget);
+}
+
+void WidgetManager::RegisterAltMouseState(MouseState* theState)
+{
+	if (std::find(mAltMouseStates.begin(), mAltMouseStates.end(), theState) == mAltMouseStates.end())
+		mAltMouseStates.push_back(theState);
+}
+
+void WidgetManager::UnregisterAltMouseState(MouseState* theState)
+{
+	mAltMouseStates.erase(std::remove(mAltMouseStates.begin(), mAltMouseStates.end(), theState), mAltMouseStates.end());
 }
 
