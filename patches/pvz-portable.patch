@@ -0,0 +1,28 @@
+#include "CoopHooks.h"
+#include <mutex>
+#include "SexyAppBase.h"
+#include "graphics/GLInterface.h"
+
+namespace Sexy
+{
+	DrawRecorder*	gDrawRecorder = nullptr;
+	AudioHook*		gAudioHook = nullptr;
+	bool			gAudioHookSuppressed = false;
+	void			(*gImageDestroyedHook)(Image* theImage) = nullptr;
+	bool			gRemoteDispatch = false;
+	int				gRemoteCursor = 0;
+	AppHook*		gAppHook = nullptr;
+	bool			gLastDrawScreenDrew = false;
+	Widget*			gUpdatingWidget = nullptr;
+
+	void ForEachMemoryImage(const std::function<void(MemoryImage*)>& theFunc)
+	{
+		std::vector<MemoryImage*> aCopy;
+		{
+			std::scoped_lock aLock(gSexyAppBase->mGLInterface->mCritSect);
+			aCopy.assign(gSexyAppBase->mMemoryImageSet.begin(), gSexyAppBase->mMemoryImageSet.end());
+		}
+		for (MemoryImage* anImage : aCopy)
+			theFunc(anImage);
+	}
+}
diff --git a/b/PvZ-Portable/src/SexyAppFramework/CoopHooks.h b/PvZ-Portable/src/SexyAppFramework/CoopHooks.h
new file mode 100644
index 0000000..956b857
--- /dev/null
+++ b/PvZ-Portable/src/SexyAppFramework/CoopHooks.h
@@ -0,0 +1,100 @@
+// Insaniquarium Co-op: framework-level hook points.
+//
+// The co-op mod streams the host's rendering, audio and music to the guest and
+// feeds the guest's mouse/keyboard back to the host as "player 2". Everything
+// game-specific lives in the game's coop/ directory; the framework only exposes
+// these narrow, inert-by-default hooks (all pointers are null in a solo game).
+
+#ifndef __SEXY_COOPHOOKS_H__
+#define __SEXY_COOPHOOKS_H__
+
+#include <cstdint>
+#include <vector>
+#include <functional>
+#include "misc/Rect.h"
+#include "misc/Point.h"
+#include "graphics/Color.h"
+
+namespace Sexy
+{
+	class Image;
+	class MemoryImage;
+	class Graphics;
+	class SexyMatrix3;
+	class TriVertex;
+	class Widget;
+
+	// Records every primitive drawn onto mTarget (the screen image). GLImage calls
+	// these before executing each primitive.
+	class DrawRecorder
+	{
+	public:
+		Image*					mTarget = nullptr;
+		virtual ~DrawRecorder() {}
+
+		virtual void			RecFillRect(const Rect& theRect, const Color& theColor, int theDrawMode) = 0;
+		virtual void			RecLine(double x1, double y1, double x2, double y2, const Color& theColor, int theDrawMode, bool aa) = 0;
+		virtual void			RecPoly(const Point* theVertices, int theNum, const Rect* theClip, const Color& theColor, int theDrawMode, int tx, int ty) = 0;
+		virtual void			RecBlt(Image* theImage, int x, int y, const Rect& theSrc, const Color& theColor, int theDrawMode, bool linear, bool mirror) = 0;
+		virtual void			RecBltF(Image* theImage, float x, float y, const Rect& theSrc, const Rect& theClip, const Color& theColor, int theDrawMode) = 0;
+		virtual void			RecBltRotated(Image* theImage, float x, float y, const Rect& theSrc, const Rect& theClip, const Color& theColor, int theDrawMode, double theRot, float cx, float cy) = 0;
+		virtual void			RecStretch(Image* theImage, const Rect& theDest, const Rect& theSrc, const Rect& theClip, const Color& theColor, int theDrawMode, bool fast, bool mirror) = 0;
+		virtual void			RecMatrix(Image* theImage, float x, float y, const SexyMatrix3& theMatrix, const Rect& theClip, const Color& theColor, int theDrawMode, const Rect& theSrc, bool blend) = 0;
+		virtual void			RecTris(Image* theImage, const TriVertex theVertices[][3], int theNum, const Rect& theClip, const Color& theColor, int theDrawMode, float tx, float ty, bool blend) = 0;
+	};
+	extern DrawRecorder*		gDrawRecorder;
+
+	// Sound/music mirroring. SoundInstance serials are unique per process.
+	class AudioHook
+	{
+	public:
+		virtual ~AudioHook() {}
+		virtual void			OnSoundPlay(uint32_t theSerial, int theSfxId, double theVolume, int thePan, float thePitch, bool looping) = 0;
+		virtual void			OnSoundStop(uint32_t theSerial) = 0;
+		virtual void			OnSoundVolume(uint32_t theSerial, double theVolume) = 0;
+		virtual void			OnSoundPan(uint32_t theSerial, int thePan) = 0;
+		virtual void			OnSoundPitch(uint32_t theSerial, float thePitch) = 0;
+
+		enum MusicOp { MUSIC_PLAY, MUSIC_STOP, MUSIC_STOP_ALL, MUSIC_FADE_IN, MUSIC_FADE_OUT, MUSIC_FADE_OUT_ALL, MUSIC_SONG_VOLUME, MUSIC_SONG_MAX_VOLUME, MUSIC_PAUSE, MUSIC_RESUME, MUSIC_PAUSE_ALL, MUSIC_RESUME_ALL };
+		virtual void			OnMusic(int theOp, int theSongId, int theOffset, double theValue, bool theFlag) = 0;
+	};
+	extern AudioHook*			gAudioHook;
+	// True while the co-op layer itself replays audio, so it isn't re-mirrored.
+	extern bool					gAudioHookSuppressed;
+
+	// Called from Image::~Image so recorders can forget about dead images.
+	extern void					(*gImageDestroyedHook)(Image* theImage);
+
+	// Every live MemoryImage (the guest hashes these to learn what it already has).
+	void						ForEachMemoryImage(const std::function<void(MemoryImage*)>& theFunc);
+
+	// Mouse/keyboard events being dispatched on behalf of the remote player.
+	// While set, cursor changes are captured into gRemoteCursor instead of
+	// being applied to this machine's OS cursor.
+	extern bool					gRemoteDispatch;
+	extern int					gRemoteCursor;
+
+	// Main-loop hooks (host: input injection + frame capture; guest: networking).
+	class AppHook
+	{
+	public:
+		virtual ~AppHook() {}
+		virtual void			PreUpdateFrames() {}
+		virtual void			PreDrawScreen() {}
+		virtual void			PostDrawScreen() {}
+		virtual bool			AllowLostFocusPause() { return true; }
+		virtual bool			KeepRunningWhenMinimized() { return false; }
+		// Called instead of sleeping until the next update. Return false to sleep as
+		// usual; true if it waited itself (it may return early, e.g. when input arrives).
+		virtual bool			IdleWait(int theMs) { (void)theMs; return false; }
+	};
+	extern AppHook*				gAppHook;
+	// Whether the WidgetManager actually drew anything in the frame just drawn.
+	extern bool					gLastDrawScreenDrew;
+	// The widget whose Update() is running right now (nullptr outside widget
+	// updates, e.g. while input is dispatched). Lets co-op tell which creature
+	// spawned a coin or a baby fish.
+	extern Widget*				gUpdatingWidget;
+}
+
+#endif
