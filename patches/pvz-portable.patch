 {	
+	// Co-op safety net: a swapped-out pointer state must never outlive its widget.
+	if (gSexyAppBase != nullptr && gSexyAppBase->mWidgetManager != nullptr)
+	{
+		for (MouseState* aState : gSexyAppBase->mWidgetManager->mAltMouseStates)
+		{
+			if (aState->mOverWidget == this)
+				aState->mOverWidget = nullptr;
+			if (aState->mLastDownWidget == this)
+			{
+				aState->mLastDownWidget = nullptr;
+				aState->mDownButtons = 0;
+			}
+		}
