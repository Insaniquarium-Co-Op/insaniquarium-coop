+// Insaniquarium Co-op: the original hold-to-feed and hold-to-fire logic,
+// parameterized by player. Player 1 reads the live pointer, player 2 its own.
+void Sexy::Board::CoopUpdateHolds(int thePlayer, int theFireX, int theFireY)
+{
+	Coop::RivalsScope aWallet(thePlayer);	// Coin Rivals: holding feeds/fires from your own wallet
+	int aMouseX = 0, aMouseY = 0;
+	bool isLeftBtnDown = false;
+	if (thePlayer == 0)
+	{
+		isLeftBtnDown = mWidgetManager->IsLeftButtonDown();
+		aMouseX = mWidgetManager->mLastMouseX;
+		aMouseY = mWidgetManager->mLastMouseY;
+	}
+	else if (!Coop::S().GetPlayerPointer(1, aMouseX, aMouseY, isLeftBtnDown))
+		isLeftBtnDown = false;
+
+	if (CoopHoldFood(thePlayer))
+	{
+		int aVal = Unk01();
+		if (!isLeftBtnDown)
+			CoopHoldFood(thePlayer) = false;
+		else if ((mGameUpdateCnt % (16 - gFoodLimit) == 0) && (CoopFoodTime(thePlayer) + 200 < aVal) &&
+			(aMouseX >= 31 && aMouseX <= 586) && (aMouseY >= 61 && aMouseY <= 399) && Buy(m0x4ac, false))
+		{
+			DropFood(aMouseX - 10, aMouseY - 10, 0, false, 20, -1);
+			Coop::S().Stats(thePlayer).mFoodDropped++;
+		}
+	}
+
+	if (CoopHoldFire(thePlayer))
+	{
+		int aVal = Unk01();
+		if (!isLeftBtnDown)
+			CoopHoldFire(thePlayer) = false;
+		else if(m0x3e4 > 11 && mGameUpdateCnt%(11 - m0x3e4 / 2) == 0 && CoopFireTime(thePlayer) + 100 < aVal && aMouseY > 40)
+		{
+			for (int i = 0; i < mBilaterusList->size(); i++)
+			{
+				Bilaterus* aBil = mBilaterusList->at(i);
+				if (aBil->Shoot(theFireX, theFireY))
+					break;
+			}
+
+			for (int i = 0; i < mMissleList1->size(); i++)
+			{
+				Missle* aMissle = mMissleList1->at(i);
+				if (aMissle->Shot(theFireX, theFireY))
+					break;
+			}
+
+			for (int i = 0; i < mAlienList->size(); i++)
+			{
+				Alien* anAlien = mAlienList->at(i);
+				if (anAlien->Shot(theFireX, theFireY))
+				{
+					Coop::S().Stats(thePlayer).mAlienHits++;
+					Coop::RivalsOnAlienShot(anAlien, thePlayer);
+					break;
+				}
+			}
+
+			Coop::S().Stats(thePlayer).mShots++;
+			SpawnLaserShot(theFireX - 40, theFireY - 40);
+			PlayZapSound();
+		}
+	}
+}
